{
  "name": "connect-chat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Real-time chat UI built with React",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
